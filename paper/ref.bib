@article{Dorst_mother_algebra,
	title = {3D Oriented Projective Geometry Through Versors of {$$\mathbb{R}^{3,3}$$}},
	volume = {26},
	issn = {1661-4909},
	url = {https://doi.org/10.1007/s00006-015-0625-y},
	doi = {10.1007/s00006-015-0625-y},
	abstract = {It is possible to set up a correspondence between 3D space and \$\$\{{\textbackslash}mathbb\{R\}{\textasciicircum}\{3,3\}\}\$\$, interpretable as the space of oriented lines (and screws), such that special projective collineations of the 3D space become represented as rotors in the geometric algebra of \$\$\{{\textbackslash}mathbb\{R\}{\textasciicircum}\{3,3\}\}\$\$. We show explicitly how various primitive projective transformations (translations, rotations, scalings, perspectivities, Lorentz transformations) are represented, in geometrically meaningful parameterizations of the rotors by their bivectors. Odd versors of this representation represent projective correlations, so (oriented) reflections can only be represented in a non-versor manner. Specifically, we show how a new and useful ‘oriented reflection’ can be defined directly on lines. We compare the resulting framework to the unoriented \$\$\{{\textbackslash}mathbb\{R\}{\textasciicircum}\{3,3\}\}\$\$approach of Klawitter (Adv Appl Clifford Algebra, 24:713–736, 2014), and the \$\$\{{\textbackslash}mathbb\{R\}{\textasciicircum}\{4,4\}\}\$\$rotor-based approach by Goldman et al. (Adv Appl Clifford Algebra, 25(1):113–149, 2015) in terms of expressiveness and efficiency.},
	number = {4},
	journal = {Advances in Applied Clifford Algebras},
	author = {Dorst, Leo},
	month = dec,
	year = {2016},
	pages = {1137--1172},
	file = {PDF:/home/brain/Zotero/storage/F8Y5XJKM/Dorst - 2016 - 3D Oriented Projective Geometry Through Versors of \$\$ mathbb R ^ 3,3 \$\$.pdf:application/pdf},
}

