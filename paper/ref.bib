@incollection{hestenes_new_2001,
	address = {Berlin, Heidelberg},
	title = {New {Algebraic} {Tools} for {Classical} {Geometry}},
	isbn = {978-3-662-04621-0},
	url = {https://doi.org/10.1007/978-3-662-04621-0_1},
	doi = {10.1007/978-3-662-04621-0_1},
	abstract = {Classical geometry has emerged from efforts to codify perception of space and motion. With roots in ancient times, the great flowering of classical geometry was in the 19th century, when Euclidean, non-Euclidean and projective geometries were given precise mathematical formulations and the rich properties of geometric objects were explored. Though fundamental ideas of classical geometry are permanently imbedded and broadly applied in mathematics and physics, the subject itself has practically disappeared from the modern mathematics curriculum. Many of its results have been consigned to the seldom-visited museum of mathematics history, in part, because they are expressed in splintered and arcane language. To make them readily accessible and useful, they need to be reexamined and integrated into a coherent mathematical system.},
	booktitle = {Geometric {Computing} with {Clifford} {Algebras}: {Theoretical} {Foundations} and {Applications} in {Computer} {Vision} and {Robotics}},
	publisher = {Springer Berlin Heidelberg},
	author = {Hestenes, David and Li, Hongbo and Rockwood, Alyn},
	editor = {Sommer, Gerald},
	year = {2001},
	pages = {3--26},
}

